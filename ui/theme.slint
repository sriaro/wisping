export global Theme {
    in-out property <bool> dark: false;
    in-out property <string> ui-font: "Segoe UI";
    in-out property <int> semi: 600;
    in-out property <float> night: 0;
    in-out property <float> fade-ms: 0;
    in-out property <float> content-opacity: 1;
    in-out property <float> content-ms: 0;
    in-out property <bool> quiet: false;
    in-out property <bool> settling: false;
    in-out property <int> shown-page: 0;
    in-out property <float> veil-target: 0;
    in-out property <float> veil-ms: 100;
    in-out property <int> enter-tick: 0;
    in-out property <float> scale: 1;
    in-out property <float> page-a: 1;
    out property <bool> calm: quiet || settling;

    out property <color> bg-base: #0b101b.mix(#e9eff8, night);
    out property <brush> bg-gradient: @linear-gradient(135deg, #111a2a.mix(#f5f9fe, night) 0%, #0b0f19.mix(#e6eef9, night) 55%, #151030.mix(#ede9fb, night) 100%);
    out property <brush> blob-a: @radial-gradient(circle, #19b8a626.mix(#38e0c434, night) 0%, #19b8a617.mix(#38e0c420, night) 22%, #19b8a60b.mix(#38e0c40f, night) 42%, #19b8a604.mix(#38e0c405, night) 62%, #19b8a601.mix(#38e0c401, night) 82%, #19b8a600.mix(#38e0c400, night) 100%);
    out property <brush> blob-b: @radial-gradient(circle, #2f5be026.mix(#3a62f030, night) 0%, #2f5be017.mix(#3a62f01d, night) 22%, #2f5be00b.mix(#3a62f00e, night) 42%, #2f5be004.mix(#3a62f005, night) 62%, #2f5be001.mix(#3a62f001, night) 82%, #2f5be000.mix(#3a62f000, night) 100%);
    out property <brush> blob-c: @radial-gradient(circle, #7b5cf024.mix(#9b7bff2c, night) 0%, #7b5cf016.mix(#9b7bff1b, night) 22%, #7b5cf00a.mix(#9b7bff0d, night) 42%, #7b5cf003.mix(#9b7bff04, night) 62%, #7b5cf001.mix(#9b7bff01, night) 82%, #7b5cf000.mix(#9b7bff00, night) 100%);
    out property <color> card: #ffffff12.mix(#ffffff99, night);
    out property <color> card-strong: #ffffff1a.mix(#ffffffbf, night);
    out property <brush> glass-tint: #0a0f1a66.mix(#f4f8ff55, night);
    out property <brush> btn-glass: @linear-gradient(180deg, #ffffff2a.mix(#ffffffe0, night) 0%, #ffffff14.mix(#ffffff80, night) 100%);
    out property <color> card-border: #ffffff22.mix(#ffffffe8, night);
    out property <color> card-border-hot: #5b8fe088.mix(#2f7bf580, night);
    out property <color> glow: #2a58c038.mix(#2f6ff030, night);
    out property <color> shadow: #00000040.mix(#1a2a5020, night);
    out property <color> text: #eff3fa.mix(#141b2b, night);
    out property <color> text-dim: #a3b0c4.mix(#4f5b70, night);
    out property <color> accent: #6f9fe6.mix(#2f6ff0, night);
    out property <brush> accent-gradient: @linear-gradient(135deg, #12857c.mix(#17bfb2, night) 0%, #2c58c4.mix(#2f6ff0, night) 100%);
    out property <color> accent-soft: #5b8fe025.mix(#2f6ff01f, night);
    out property <color> nav-active: #5b8fe025.mix(#2f6ff020, night);
    out property <color> press: #2f6ff02e.mix(#7fb0ff38, night);
    out property <color> sep: #ffffff14.mix(#1420401a, night);
    out property <color> hover: #ffffff16.mix(#14204012, night);
    out property <color> chip-bg: #ffffff10.mix(#ffffff8c, night);
    out property <color> switch-off: #3b4659.mix(#c8d1df, night);
    out property <color> ring-track: #ffffff22.mix(#5b687d1a, night);
    out property <color> check-border: #5e6b80.mix(#a5b1c4, night);
    out property <color> scroll-thumb: #5e6b8099.mix(#8896ab88, night);
    out property <color> danger: #e5696e.mix(#d12f36, night);
    out property <color> danger-soft: #ff6b702e.mix(#e5484d1f, night);
    out property <color> warn: #e0b240.mix(#b45a00, night);
    out property <color> warn-soft: #fbbf2426.mix(#f59e0b26, night);
    out property <color> ok: #3dbb8a.mix(#037a56, night);
    out property <color> ok-soft: #34d39926.mix(#10b98122, night);
    out property <color> scrim: #000000a6.mix(#10182866, night);
    out property <color> dialog-bg: #171f30f2.mix(#fffffff7, night);

    pure public function tint-fg(t: int) -> color {
        if (t == 0) { return #38b8a8.mix(#0f9f8f, night); }
        if (t == 1) { return #6f9fe6.mix(#2f6ff0, night); }
        if (t == 2) { return #9a84e0.mix(#7c5cf0, night); }
        if (t == 3) { return #df9f5a.mix(#d9680a, night); }
        if (t == 4) { return #d96fa8.mix(#db3e86, night); }
        if (t == 5) { return #4cc27a.mix(#16a34a, night); }
        if (t == 6) { return #e5696e.mix(#dc3c42, night); }
        return #8a97ab.mix(#5b687d, night);
    }

    pure public function snap(v: length) -> length {
        return round(v / 1px * max(scale, 0.25)) / max(scale, 0.25) * 1px;
    }

    pure public function glide(rest: float, d: length) -> length {
        return snap(d * rest * rest);
    }

    pure public function tint-bg(t: int) -> color {
        return tint-fg(t).with-alpha(0.16);
    }
}

export global Geo {
    pure callback squircle(float, float, float, float) -> string;
}

export global T {
    in-out property <int> rev: 0;
    pure callback t(string, int) -> string;

    pure public function s(key: string) -> string {
        return t(key, rev);
    }
}

export struct CatItem {
    id: string,
    group: string,
    name: string,
    desc: string,
    risk: string,
    risk-tone: int,
    icon: string,
    tint: int,
    size: string,
    count: string,
    selected: bool,
    locked: bool,
    scanned: bool,
}

export struct DetailRow {
    name: string,
    place: string,
    size: string,
    count: string,
    icon: string,
    tint: int,
    share: float,
    percent: string,
    path: string,
}

export struct DriveItem {
    name: string,
    text: string,
    frac: float,
    tone: int,
}

export struct TopItem {
    name: string,
    size: string,
    risk: string,
    risk-tone: int,
}

export struct IssueItem {
    kind-name: string,
    title: string,
    detail: string,
    tint: int,
    selected: bool,
    locked: bool,
}

export struct StartItem {
    idx: int,
    icon: string,
    publisher: string,
    system: bool,
    name: string,
    command: string,
    kind-name: string,
    tint: int,
    enabled: bool,
    can-toggle: bool,
    can-delete: bool,
    missing: bool,
    locked: bool,
    admin: bool,
    tag: string,
    tone: int,
}

