    in-out property <int> page: 0;
    in-out property <bool> maximized: false;
    in-out property <bool> has-report: false;
    in-out property <bool> glass-enabled: true;
    in-out property <bool> glass-active: false;
    in-out property <bool> keep-recent: true;
    in-out property <bool> busy: false;
    in-out property <string> status;
    in-out property <bool> is-admin: false;
    in-out property <string> low-disk-text;

    in-out property <int> ring-mode: 0;
    in-out property <string> hero-title;
    in-out property <string> hero-text;
    in-out property <string> ring-big;
    in-out property <string> ring-small;
    in-out property <string> tile-junk;
    in-out property <string> tile-reg;
    in-out property <string> tile-start;
    in-out property <bool> can-clean-now: false;
    in-out property <[DriveItem]> drives: [];
    in-out property <[TopItem]> tops: [];

    in-out property <[CatItem]> cats: [];
    in-out property <string> clean-selected-text;
    in-out property <bool> can-run-clean: false;

    in-out property <[IssueItem]> issues: [];
    in-out property <[int]> issues-epoch: [0];
    in-out property <bool> reg-scanned: false;
    in-out property <string> reg-count-text;
    in-out property <string> reg-selected-text;
    in-out property <bool> can-fix: false;

    in-out property <[StartItem]> startups: [];
    in-out property <[int]> startups-epoch: [0];
    in-out property <string> start-count-text;
    in-out property <int> start-tab: 0;
    in-out property <[string]> start-tab-names: [];
    in-out property <string> start-sub;
    in-out property <bool> start-show-system: false;

    in-out property <bool> dialog-open: false;
    in-out property <string> dialog-title;
    in-out property <string> dialog-text;
    in-out property <string> dialog-ok;
    in-out property <bool> dialog-danger: false;
    in-out property <bool> dialog-single: false;

    in-out property <bool> toast-open: false;
    in-out property <string> toast-text;

    in-out property <bool> details-open: false;
    in-out property <bool> details-loading: false;
    in-out property <bool> startups-loading: false;
    in-out property <string> details-title;
    in-out property <string> details-sub;
    in-out property <string> details-icon: "folder";
    in-out property <int> details-tint: 1;
    in-out property <string> details-total;
    in-out property <[DetailRow]> details-rows: [];
    in-out property <[int]> details-epoch: [0];
    callback show-details(int);
    callback close-details();
    callback open-location(string);

    callback scan-all();
    callback analyze();
    callback clean();
    callback scan-reg();
    callback fix-reg();
    callback refresh-start();
    callback toggle-cat(int);
    callback select-safe();
    callback toggle-issue(int);
    callback select-all-issues();
    callback select-start-tab(int);
    callback set-show-system(bool);
    callback toggle-start(int, bool);
    callback delete-start(int);
    callback open-backups();
    callback open-report();
    callback toggle-keep-recent(bool);
    callback page-moved(int);
    callback restart-admin();
    callback window-changed();
    callback toggle-theme();
    callback toggle-lang();
    callback dismiss-low-disk();
    callback window-drag();
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    callback window-resize(int);
    callback dialog-accept();
    callback dialog-cancel();
}
